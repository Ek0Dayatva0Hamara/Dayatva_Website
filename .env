'''
    This file is used to define environment-specific variables for the local development environment.
    It allows you to configure settings such as API keys, database connection strings, and other
    sensitive information that should not be hardcoded in the source code. These variables are
    loaded into the application at runtime, ensuring that the correct configuration is used
    without exposing sensitive data in the codebase.
'''
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
